# =====================================================================
# SatQuery AI — Local/Agent Environment Variables
# Copy this file to `.env` (gitignored) and fill in your real values.
# NEVER commit the real `.env` — it contains secrets.
# =====================================================================

# ---- LLM / VLM Provider Router (runtime agent) ----
# OpenRouter (multi-provider gateway: Qwen, GPT, Gemini, Claude, DeepSeek, ...)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Preferred model for the end-user VLM agent (e.g. "qwen/qwen2.5-vl-72b-instruct")
SATQUERY_VLM_MODEL=

# NVIDIA NIM (self-hosted / hosted remote-sensing or general VLM endpoints)
NVIDIA_NIM_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Fallback / additional providers if you have them
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Autonomous Build Farm (orchestrator) ----
# Which model is the MAIN agents (planner/reviewer) vs the CODER.
# Values like "openrouter/openai/gpt-5", "openrouter/anthropic/claude-sonnet-4", etc.
PLANNER_MODEL=
CODER_MODEL=
REVIEWER_MODEL=

# ---- Daytona (build workers / heavy backend) ----
# One or more Daytona clouds. Repeat the block with _2, _3 ... for additional accounts.
DAYTONA_API_KEY=
DAYTONA_PORTAL_URL=
DAYTONA_PROVIDER=
DAYTONA_TARGET=
# Daytona workspace prebuild image for the worker (e.g. python:3.11 + node:20)
DAYTONA_BUILD_IMAGE=

# ---- FastAPI backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
